<?xml version="1.0" encoding="utf-8"?>
<!-- About page, laid out like the About screen of Morphe Manager and shown full screen:
     app header (opens the app info page), version card with update status, Morphe's
     official links, the included libraries and Close. The top padding puts the header's
     content 96dp below the status bar, level with the large title of the other pages. System
     bar insets are added to main_container's padding in AbstractAboutFragment. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="88dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Header: logo tile, then Morphe over the part of it this is, as Morphe Manager names
             itself ("Morphe", "Manager") and the patched apps ("Morphe", "Patches"). Tapping it
             opens the app info page. The tile's tone follows the theme and is set in AbstractAboutFragment.
             Its padding leaves the ripple room, and the negative margin puts the tile in line with
             the cards below, as in Morphe Manager. The logo fills the tile with no padding: ShapeableImageView
             cuts its shape inside the padding, which would shrink the tile, and the logo's own
             margins already set it in the tile as Manager sets its logo. -->
        <LinearLayout
            android:id="@+id/app_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:layout_marginEnd="-8dp"
            android:background="@drawable/about_header_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/app_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_microg_logo"
                app:shapeAppearanceOverlay="?attr/shapeAppearanceCornerLargeIncreased" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/app_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_morphe"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_microg_re"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Version card -->
        <com.google.android.material.card.MaterialCardView
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:shapeAppearance="?attr/shapeAppearanceCornerLargeIncreased">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/about_morphe_version"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/about_prerelease_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_warning_background"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="@string/about_morphe_prerelease"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="@color/badge_warning_content"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/app_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="?attr/colorOnSurface"
                    android:textDirection="ltr"
                    android:textStyle="bold"
                    tools:text="7.4.1-dev.1" />

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/about_status_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- Release check result, as Morphe's About shows its own: "Up to date" as a line, or
                     "Update available: <version>" and an Update pill. Both semibold where the
                     platform can weigh a font (API 28), medium before it. -->
                <TextView
                    android:id="@+id/about_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:textFontWeight="600"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone"
                    tools:targetApi="p"
                    tools:text="@string/about_morphe_up_to_date"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/about_update_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/about_update_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:textFontWeight="600"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimary"
                        tools:targetApi="p" />

                    <!-- Morphe's action pill in its large size and primary colors: the download
                         icon before its label, as Morphe Manager and the patched apps show it. -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/about_update_badge"
                        style="@style/Widget.Material3Expressive.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="80dp"
                        android:minHeight="40dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textColor="?attr/colorOnPrimaryContainer"
                        app:backgroundTint="?attr/colorPrimaryContainer"
                        app:icon="@drawable/ic_about_update"
                        app:iconGravity="textStart"
                        app:iconPadding="4dp"
                        app:iconSize="20dp"
                        app:iconTint="?attr/colorOnPrimaryContainer" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Official links -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/about_morphe_links"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/morphe_donate"
            style="@style/Widget.MicroG.MorpheLink"
            android:layout_width="match_parent"
            android:text="@string/about_morphe_donate"
            app:icon="@drawable/ic_donate" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/morphe_website"
                style="@style/Widget.MicroG.MorpheLink"
                android:layout_width="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/about_morphe_website"
                app:icon="@drawable/ic_website" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/morphe_github"
                style="@style/Widget.MicroG.MorpheLink"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/about_morphe_github"
                app:icon="@drawable/ic_code" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/morphe_reddit"
                style="@style/Widget.MicroG.MorpheLink"
                android:layout_width="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/about_morphe_reddit"
                app:icon="@drawable/ic_forum" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/morphe_translations"
                style="@style/Widget.MicroG.MorpheLink"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/about_morphe_translations"
                app:icon="@drawable/ic_translate" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/morphe_contributors"
                style="@style/Widget.MicroG.MorpheLink"
                android:layout_width="0dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/about_morphe_contributors"
                app:icon="@drawable/ic_contributors" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/morphe_supporters"
                style="@style/Widget.MicroG.MorpheLink"
                android:layout_width="0dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/about_morphe_supporters"
                app:icon="@drawable/ic_volunteer" />
        </LinearLayout>

        <!-- Included libraries -->
        <TextView
            android:id="@+id/libraries_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/about_root_libraries"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:id="@+id/library_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/about_close"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="56dp"
            android:text="@string/about_morphe_close"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
